# Keep the dist archive to what an application actually needs. Everything below
# is development scaffolding — excluding it makes `composer require` smaller and
# keeps the package's own CI out of consumers' repositories.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon       export-ignore
/pint.json          export-ignore
/CONTRIBUTING.md    export-ignore
/PLAN.md            export-ignore

# Line endings are normalised so a Windows checkout does not produce a diff.
* text=auto eol=lf
*.php  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
