{
    "name": "linqelio/linqelio-laravel",
    "description": "Laravel integration for Linqelio — one API for WhatsApp, Telegram and Viber conversations.",
    "keywords": ["laravel", "linqelio", "whatsapp", "telegram", "viber", "messaging", "omnichannel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Linqelio\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linqelio\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Linqelio\\Laravel\\LinqelioServiceProvider"
            ],
            "aliases": {
                "Linqelio": "Linqelio\\Laravel\\Facades\\Linqelio"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse",
        "contract:sync": "@php scripts/sync-contract.php",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check": "Everything CI runs: Pint, PHPStan and the test suite."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
